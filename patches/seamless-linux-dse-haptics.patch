@@ -0,0 +1,695 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "bbcoop/combat_haptics.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <optional>
+#include <string_view>
+
+#include "common/logging/log.h"
+#include "core/bloodborne_re_internal.h"
+
+namespace {
+namespace Game = Core::Bloodborne;
+namespace Coop = Game::Coop;
+using Core::GuestRegisterSnapshot;
+using Coop::TryRead;
+
+using Clock = std::chrono::steady_clock;
+using namespace std::chrono_literals;
+
+u64 guest_image, guest_size;
+std::atomic_bool enabled;
+bool npc_type_verified;
+bool trace_contacts;
+constexpr u64 EnemyVtable = 0x0538EBC0;
+constexpr u64 NpcParamFunction = 0x018E8DA0;
+constexpr std::array<u8, 8> NpcParamAccess{0x48, 0x8B, 0x87, 0xC8, 0x03, 0x00, 0x00, 0xC3};
+constexpr u64 SwingStartedOffset = 0x01A29789;
+constexpr std::array<u8, 10> SwingStarted{0x43, 0xC6, 0x44, 0xE5, 0x24, 0x01, 0x49, 0x8B, 0x7D, 0x08};
+constexpr u64 ScriptActivateOffset = 0x009E3700;
+constexpr u64 ScriptDeactivateOffset = 0x009E38B0;
+constexpr std::array<u8, 8> ScriptPrologue{0x55, 0x48, 0x89, 0xE5, 0x41, 0x57, 0x41, 0x56};
+constexpr u64 ObjectActionOffset = 0x013AEB69;
+constexpr std::array<u8, 7> ObjectAction{0x89, 0x41, 0x20, 0x48, 0x8B, 0x4A, 0x20};
+constexpr u64 RotateActionOffset = 0x013E116D;
+constexpr std::array<u8, 8> RotateAction{0x44, 0x89, 0x60, 0x20, 0x48, 0x8B, 0x41, 0x20};
+constexpr u64 ItemReceiptOffset = 0x016D896E;
+constexpr std::array<u8, 7> ItemReceipt{0x48, 0x89, 0x08, 0x48, 0x89, 0x43, 0x08};
+constexpr u64 ItemReceiptQueueOffset = 0x0553B1C0;
+constexpr u64 EffectAppliedOffset = 0x018C6AAC;
+constexpr std::array<u8, 7> EffectApplied{0x49, 0x8B, 0x45, 0x00, 0x4C, 0x89, 0xEF};
+constexpr u64 MapImpactOffset = 0x018837C0;
+constexpr std::array<u8, 8> MapImpact{0x49, 0x63, 0x45, 0x5C, 0x49, 0x63, 0x4D, 0x64};
+constexpr u64 ObjectImpactOffset = 0x015A5348;
+constexpr std::array<u8, 7> ObjectImpact{0x4C, 0x89, 0xB5, 0xC8, 0xFB, 0xFF, 0xFF};
+constexpr size_t HitBehavior = 0x38, HitOwner = 0x1E0, HitTarget = 0x1E8;
+constexpr size_t HitHandle = 0x1F0, HitSoundMaterial = 0x224;
+
+struct Vitals {
+    s32 hp;
+    s32 maximum;
+};
+
+struct Hit {
+    u64 victim = 0;
+    u64 attacker = 0;
+    u64 player = 0;
+    u64 record = 0;
+    Vitals before{};
+    Clock::time_point when{};
+};
+thread_local Hit pending_hit;
+
+struct TimedEffect {
+    BbCombatHapticEvent event{};
+    Clock::time_point when{};
+};
+
+enum class MeleeStrength { Light, Heavy, Charged };
+constexpr std::array HitActions{BB_HAPTIC_LIGHT_HIT, BB_HAPTIC_HEAVY_HIT, BB_HAPTIC_CHARGED_HIT};
+constexpr std::array SwingActions{BB_HAPTIC_LIGHT_SWING, BB_HAPTIC_HEAVY_SWING, BB_HAPTIC_CHARGED_SWING};
+
+struct Melee {
+    u32 behavior = 0;
+    MeleeStrength strength = MeleeStrength::Light;
+    BbCombatWeaponProfile weapon = BB_HAPTIC_STANDARD;
+    u32 item = 0;
+    BbCombatWeaponForm form = BB_HAPTIC_FORM_NORMAL;
+    Clock::time_point when{};
+};
+
+std::mutex event_lock;
+TimedEffect attack, damage, charge, activity;
+std::atomic_bool heavy_down;
+bool charge_active, last_world_object;
+Clock::time_point last_swing, last_hit, last_shot, last_world;
+std::array<Clock::time_point, BB_HAPTIC_ACTION_COUNT> last_activity;
+std::array<Melee, 24> recent_melee;
+size_t next_melee;
+
+bool QueueActivity(BbCombatHapticEvent event, std::chrono::milliseconds interval) {
+    std::scoped_lock lock(event_lock);
+    const auto now = Clock::now();
+    auto& last = last_activity[static_cast<size_t>(event.action)];
+    if (now - last < interval) return false;
+    last = now;
+    activity = {event, now};
+    return true;
+}
+
+u64 Player() {
+    const u64 world = TryRead<u64>(guest_image, Coop::CandidateLocalStatePointerOffset).value_or(0);
+    const u64 player = world >= 0x10000 ? TryRead<u64>(world, 0x60).value_or(0) : 0;
+    const u64 table = player >= 0x10000 ? TryRead<u64>(player, 0).value_or(0) : 0;
+    return table >= guest_image && table - guest_image < guest_size ? player : 0;
+}
+
+u64 CharacterData(u64 player) {
+    const u64 modules = TryRead<u64>(player, 0x3B0).value_or(0);
+    return modules >= 0x10000 ? TryRead<u64>(modules, 0x20).value_or(0) : 0;
+}
+
+u64 HavokCharacter(u64 player) {
+    const u64 modules = TryRead<u64>(player, 0x3B0).value_or(0);
+    const u64 behavior = TryRead<u64>(modules, 0x30).value_or(0);
+    const u64 proxy = TryRead<u64>(behavior, 0x10).value_or(0);
+    return TryRead<u64>(proxy, 0x18).value_or(0);
+}
+
+std::optional<Vitals> ReadVitals(u64 player) {
+    const u64 data = CharacterData(player);
+    if (data < 0x10000) return std::nullopt;
+    const auto hp = TryRead<s32>(data, 0xF8);
+    const auto max = TryRead<s32>(data, 0xFC);
+    if (!hp || !max || *max <= 0 || *hp > *max) return std::nullopt;
+    return Vitals{std::max(*hp, 0), *max};
+}
+
+u32 BaseWeaponId(s32 id) {
+    return id >= 1000000 ? static_cast<u32>(id - id % 100000) : 0;
+}
+
+u32 EquippedWeapon(u64 player, bool left = false) {
+    const u64 equipment = TryRead<u64>(player, 0x4B8).value_or(0);
+    if (equipment < 0x10000) return 0;
+    const s32 hand = TryRead<s32>(equipment, left ? 0x0C : 0x10).value_or(-1);
+    if (hand != 0 && hand != 1) return 0;
+    const size_t slot = static_cast<size_t>(hand * 2 + (left ? 0 : 1));
+    return BaseWeaponId(TryRead<s32>(equipment, 0x64 + slot * sizeof(s32)).value_or(-1));
+}
+
+u32 WeaponVariation(u32 item) {
+    return item == 38000000 ? 101 : item / 10000; // Kos's untransformed fist row.
+}
+
+BbCombatWeaponForm MeleeForm(u32 variation, u32 judge) {
+    if ((judge >= 400 && judge < 790) || judge == 390 || judge == 395)
+        return BB_HAPTIC_FORM_TRANSFORMED;
+    if (judge >= 930) {
+        switch (variation) {
+        case 200: case 400: case 500: case 510: case 800: case 810: case 900:
+        case 1000: case 1010: case 1200: case 1300: case 2600: case 2700: case 3100:
+            return BB_HAPTIC_FORM_TRANSFORMED;
+        default:
+            break;
+        }
+    }
+    return BB_HAPTIC_FORM_NORMAL;
+}
+
+BbCombatWeaponProfile MeleeProfile(u32 variation, u32 judge, u8 attack_type) {
+    const bool transformed = MeleeForm(variation, judge) == BB_HAPTIC_FORM_TRANSFORMED;
+    switch (variation) {
+    case 100: case 101: case 3400: return BB_HAPTIC_FIST;
+    case 200: return transformed || judge == 930 || judge == 940 ?
+                     BB_HAPTIC_LONG_BLADE : BB_HAPTIC_LIGHT_BLADE;  // Chikage
+    case 400: case 900: case 2700: return BB_HAPTIC_LIGHT_BLADE;  // Mercy, Claw, Rakuyo
+    case 500: return transformed || judge == 930 || judge == 931 ? BB_HAPTIC_LONG_AXE : BB_HAPTIC_AXE;
+    case 510: return transformed ? BB_HAPTIC_AXE : BB_HAPTIC_LONG_BLADE;  // Burial Blade
+    case 700: return transformed ? BB_HAPTIC_EXTENDED_SAW : BB_HAPTIC_SAW;
+    case 710: return attack_type == 2 ? BB_HAPTIC_THRUST :
+                     transformed ? BB_HAPTIC_EXTENDED_SAW : BB_HAPTIC_SAW;
+    case 800: return attack_type == 1 ? BB_HAPTIC_HAMMER :  // Kirkhammer
+                     attack_type == 2 ? BB_HAPTIC_THRUST : BB_HAPTIC_LIGHT_BLADE;
+    case 810: return transformed ? BB_HAPTIC_LONG_BLADE : BB_HAPTIC_LIGHT_BLADE;
+    case 1000: case 1010: case 3000: return attack_type == 0 ? BB_HAPTIC_LIGHT_BLADE : BB_HAPTIC_THRUST;
+    case 1100: return judge == 930 ? BB_HAPTIC_EXPLOSIVE : BB_HAPTIC_FIST;  // Stake Driver
+    case 1200: return transformed || judge >= 930 ? BB_HAPTIC_ROTARY : BB_HAPTIC_HAMMER;
+    case 1300: return BB_HAPTIC_HAMMER;  // Tonitrus
+    case 2000: return BB_HAPTIC_HEAVY_WHIP;  // Torch flare and wood handle
+    case 2200: return transformed ? BB_HAPTIC_WHIP :
+                      attack_type == 2 ? BB_HAPTIC_THRUST : BB_HAPTIC_LIGHT_BLADE;
+    case 2300: return transformed ? BB_HAPTIC_LONG_BLADE : BB_HAPTIC_LIGHT_BLADE;
+    case 2400: return transformed ? BB_HAPTIC_HEAVY_WHIP : BB_HAPTIC_HAMMER;
+    case 2500: return attack_type == 1 ? BB_HAPTIC_HAMMER : BB_HAPTIC_HEAVY_WHIP;
+    case 2600: return transformed ? BB_HAPTIC_ARCANE : BB_HAPTIC_LONG_BLADE;
+    case 2800: return transformed ? BB_HAPTIC_EXPLOSIVE : BB_HAPTIC_HAMMER;
+    case 2900: return transformed ? BB_HAPTIC_AXE : BB_HAPTIC_HAMMER;
+    case 3100: return transformed || (judge >= 930 && judge <= 932) || judge == 952 || judge == 953 ?
+                      BB_HAPTIC_ROTARY : BB_HAPTIC_HAMMER;
+    case 3200: return BB_HAPTIC_LIGHT_BLADE;
+    case 3700: case 3800: return BB_HAPTIC_ARCANE;  // Parasite with Milkweed
+    default: return attack_type == 2 ? BB_HAPTIC_THRUST : BB_HAPTIC_STANDARD;
+    }
+}
+
+std::optional<BbCombatWeaponProfile> ProjectileProfile(s32 id) {
+    // The spawn request carries a BehaviorParam_PC ID. Child BulletParam rows are
+    // travel and impact stages of the same shot, and must not repeat recoil.
+    switch (id) {
+    case 101400800: case 101400810:  // Hunter Pistol and Evelyn
+    case 101010390: case 101010395: case 101010500: case 101010510: case 101010520:
+    case 101010610: case 101010660: case 101010670: case 101010680:
+    case 101010690: case 101010730: case 101010930:  // Reiterpallasch
+        return BB_HAPTIC_PISTOL;
+    case 101410800: case 101410810:
+        return BB_HAPTIC_REPEATING_PISTOL;
+    case 100610800: case 100610810: case 103600800: case 103600810:
+    case 101000390: case 101000395: case 101000500: case 101000510: case 101000520:
+    case 101000660: case 101000670: case 101000680: case 101000690:  // Rifle Spear
+        return BB_HAPTIC_RIFLE;
+    case 100600800: case 100600810:
+        return BB_HAPTIC_BLUNDERBUSS;
+    case 101500800: case 101500810: case 103500800: case 103500810:
+        return BB_HAPTIC_CANNON;
+    case 103300000: case 103300800: case 103300810:
+        return BB_HAPTIC_GATLING;
+    case 101810800: case 101810810: case 101800800: case 101800810:
+        return BB_HAPTIC_SPRAYER;
+    case 103200390: case 103200395: case 103200400: case 103200550:
+    case 103200570: case 103200600:
+        return BB_HAPTIC_BOW;
+    case 102600590: case 102600591: case 102600592: case 102600612: case 102600712: case 102600732:
+        return BB_HAPTIC_ARCANE;
+    default: return std::nullopt;
+    }
+}
+
+MeleeStrength ClassifyMelee(u32 behavior, u64 row) {
+    // BehaviorParam_PC: 100000000 + 1000 * weapon variation + animation judge ID.
+    if (behavior == 101000970 || (TryRead<u8>(row, 0x81).value_or(0) & 0x08)) return MeleeStrength::Charged;
+    switch (behavior % 1000) {
+    case 170: case 171: case 180:
+    case 570: case 571: case 572: case 575: case 580: case 581: case 585:
+        return MeleeStrength::Charged;
+    case 100: case 110: case 120: case 130: case 140: case 150: case 210:
+    case 260: case 270: case 280: case 290: case 330: case 331:
+    case 500: case 501: case 502: case 510: case 511: case 512:
+    case 520: case 521: case 522: case 530: case 550: case 551: case 555: case 560:
+    case 610: case 611: case 612: case 660: case 670: case 680: case 681:
+    case 690: case 691: case 731:
+        return MeleeStrength::Heavy;
+    default:
+        return MeleeStrength::Light;
+    }
+}
+
+const Melee* FindMelee(u64 hit, Clock::time_point now) {
+    const u32 behavior = TryRead<u32>(hit, HitBehavior).value_or(0);
+    if (behavior < 100000000 || behavior >= 104000000) return nullptr;
+    // A single move can allocate child volumes with different handles but the same behavior.
+    for (size_t i = 1; i <= recent_melee.size(); ++i) {
+        const auto& melee = recent_melee[(next_melee + recent_melee.size() - i) % recent_melee.size()];
+        if (now - melee.when >= 5s) break;
+        if (melee.behavior == behavior) return &melee;
+    }
+    return nullptr;
+}
+
+bool IsBoss(u64 character) {
+    const u64 table = TryRead<u64>(character, 0).value_or(0);
+    if (npc_type_verified && table == guest_image + EnemyVtable &&
+        TryRead<u64>(table, 0x168) == guest_image + NpcParamFunction) {
+        // This EnemyIns getter is just a load of +0x3C8. Read the same data without a guest call.
+        const u64 holder = TryRead<u64>(character, 0x3C8).value_or(0);
+        const u64 row = holder >= 0x10000 ? TryRead<u64>(holder, 8).value_or(0) : 0;
+        if (row >= 0x10000 && TryRead<u8>(row, 0x12E) == 1) return true;
+    }
+    const s32 handle = TryRead<s32>(character, 0x08).value_or(-1);
+    const u64 gauges = TryRead<u64>(guest_image, Game::BossGaugesPointerOffset).value_or(0);
+    if (handle <= 0 || gauges < 0x10000) return false;
+    for (size_t slot = 0; slot < 3; ++slot) {
+        const size_t offset = 0x1658 + slot * 0x14;
+        if (TryRead<s32>(gauges, offset + 4) == handle &&
+            TryRead<u8>(gauges, offset + 0x10).value_or(0) != 0) return true;
+    }
+    return false;
+}
+
+BbCombatSurface WorldSurface(s32 material, bool object) {
+    // Terrain HitMtrlParam and ObjectParam use different meanings for 10.
+    switch (material) {
+    case 1: case 2: case 32: return BB_HAPTIC_SURFACE_STONE;
+    case 4: case 30: case 38: return BB_HAPTIC_SURFACE_WOOD;
+    case 9: return BB_HAPTIC_SURFACE_METAL;
+    case 10: return object ? BB_HAPTIC_SURFACE_FLESH : BB_HAPTIC_SURFACE_UNKNOWN;
+    case 27: return BB_HAPTIC_SURFACE_FLESH;
+    default: return BB_HAPTIC_SURFACE_UNKNOWN;
+    }
+}
+
+BbCombatSurface CharacterSurface(u64 record) {
+    // These defender sound materials resolve to the iron/spark layers of sprj_main.
+    switch (TryRead<s32>(record, HitSoundMaterial).value_or(-1)) {
+    case 50: case 51: case 54: case 56: case 57: case 79: return BB_HAPTIC_SURFACE_METAL;
+    case 52: case 55: return BB_HAPTIC_SURFACE_WOOD;
+    default: return BB_HAPTIC_SURFACE_FLESH;  // The contact already removed HP.
+    }
+}
+
+void PS4_SYSV_ABI OnWorldImpact(u64 object, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    // Both ordinary object contacts and destruction converge at the object site.
+    const u64 record = object ? registers->r12 : registers->r13;
+    const u64 target = object ? registers->r14 : registers->r15;
+    const u64 player = Player();
+    if (!player || !target || TryRead<u64>(record, HitOwner) != player ||
+        TryRead<u64>(record, HitTarget) != target || TryRead<s32>(record, HitHandle).value_or(-1) < 0) return;
+    const s32 material = TryRead<s32>(record, HitSoundMaterial).value_or(-1);
+    if (material < 0) return;
+    const s32 sound_material = object ? material : material % 100;
+    if (sound_material == 29) return;  // 29 is empty collision.
+
+    std::scoped_lock lock(event_lock);
+    const auto now = Clock::now();
+    if (now - last_hit < 95ms || (now - last_world < 95ms && (!object || last_world_object))) return;
+    const Melee* melee = FindMelee(record, now);
+    if (!melee) return;
+    last_world = now;
+    last_world_object = object != 0;
+    constexpr std::array<u8, 3> levels{186, 222, 255};
+    const auto strength = levels[static_cast<size_t>(melee->strength)];
+    const auto surface = WorldSurface(sound_material, object != 0);
+    attack = {{BB_HAPTIC_WORLD_IMPACT, melee->weapon, strength, 0, surface, melee->item, melee->form}, now};
+    if (trace_contacts) {
+        LOG_NOTICE(Loader, "DSE {} contact material {}, surface {}", object ? "object" : "map",
+                   material, static_cast<unsigned>(surface));
+    }
+}
+
+void PS4_SYSV_ABI BeforeHit(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    const u64 player = Player();
+    const u64 victim = TryRead<u64>(registers->rdi, 0x08).value_or(0);
+    const u64 attacker = registers->rsi;
+    if (!player || victim < 0x10000 || attacker < 0x10000 || attacker == victim ||
+        (player != victim && player != attacker)) return;
+    const auto before = ReadVitals(victim);
+    if (!before || before->hp == 0) return;
+    pending_hit = {victim, attacker, player, registers->rdx, *before, Clock::now()};
+}
+
+void PS4_SYSV_ABI AfterHit(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled || !pending_hit.victim) return;
+    const u64 victim = TryRead<u64>(registers->r14, 0x08).value_or(0);
+    if (victim != pending_hit.victim || registers->r12 != pending_hit.record) return;
+    const Hit hit = pending_hit;
+    pending_hit = {};
+    const auto now = Clock::now();
+    if (now - hit.when > 350ms) return;
+    const auto after = ReadVitals(victim);
+    if (!after || after->maximum != hit.before.maximum || after->hp >= hit.before.hp) return;
+
+    std::scoped_lock lock(event_lock);
+    if (victim == hit.player) {
+        const s64 loss = hit.before.hp - after->hp;
+        const s64 percent = 100 * loss / hit.before.maximum;
+        const bool heavy = percent >= 12 || after->hp == 0;
+        const auto strength = static_cast<uint8_t>(std::clamp<s64>(115 + percent * 5, 115, 255));
+        if (now - damage.when >= 110ms || damage.event.strength < strength) {
+            damage = {{heavy ? BB_HAPTIC_HEAVY_DAMAGE : BB_HAPTIC_LIGHT_DAMAGE,
+                       BB_HAPTIC_STANDARD, strength, static_cast<uint8_t>(IsBoss(hit.attacker)),
+                       BB_HAPTIC_SURFACE_UNKNOWN}, now};
+        }
+        return;
+    }
+    const Melee* melee = FindMelee(hit.record, now);
+    if (now - last_hit < 80ms || (!melee && now - last_shot < 220ms)) return;
+    last_hit = now;
+    const auto action = melee ? HitActions[static_cast<size_t>(melee->strength)] : BB_HAPTIC_LIGHT_HIT;
+    const u32 item = melee ? melee->item : EquippedWeapon(hit.player);
+    const auto weapon = melee ? melee->weapon : MeleeProfile(WeaponVariation(item), 0, 255);
+    const auto form = melee ? melee->form : BB_HAPTIC_FORM_NORMAL;
+    attack = {{action, weapon, 255, 0, CharacterSurface(hit.record), item, form}, now};
+}
+
+void PS4_SYSV_ABI OnProjectile(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    const u64 player = Player();
+    if (!player) return;
+    const u32 handle = TryRead<u32>(player, 0x08).value_or(0);
+    const u32 owner = TryRead<u32>(registers->rsi, Game::BulletRequestOwnerOffset).value_or(0);
+    if (!handle || handle != owner) return;
+    const s32 id = TryRead<s32>(registers->rsi, Game::BulletRequestIdOffset).value_or(-1);
+    if (trace_contacts) LOG_NOTICE(Loader, "DSE projectile request {}", id);
+    const auto weapon = ProjectileProfile(id);
+    if (!weapon) return;
+
+    std::scoped_lock lock(event_lock);
+    const auto now = Clock::now();
+    const auto interval = *weapon == BB_HAPTIC_GATLING ? 48ms : *weapon == BB_HAPTIC_SPRAYER ? 125ms : 85ms;
+    if (now - last_shot < interval) return;
+    last_shot = now;
+    const u32 variation = (static_cast<u32>(id) - 100000000) / 1000;
+    const bool integrated = variation == 1000 || variation == 1010 || variation == 2600 || variation == 3200;
+    const u32 item = EquippedWeapon(player, !integrated);
+    attack = {{BB_HAPTIC_SHOT, *weapon, 255, 0, BB_HAPTIC_SURFACE_UNKNOWN, item,
+               BB_HAPTIC_FORM_PROJECTILE}, now};
+}
+
+void PS4_SYSV_ABI OnSwingStarted(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    // The game has created the melee attack volume. R13 owns this attack slot.
+    const u64 player = Player();
+    if (!player || TryRead<u64>(registers->r13, 0x08) != player) return;
+    const auto behavior = static_cast<u32>(registers->r14);
+    if (behavior < 100000000 || behavior >= 104000000) return;
+    const u64 attack_data = registers->rbp - 0x110;
+    const u64 lookup = registers->rbp - 0x50;
+    const auto selected_row = TryRead<s32>(attack_data, 8);
+    const bool owned = TryRead<u64>(attack_data, 0) == player;
+    const bool same_row = owned && selected_row &&
+        TryRead<s32>(attack_data, 0x0C) == 1 && TryRead<s32>(lookup, 4) == 1 &&
+        TryRead<s32>(lookup, 0) == selected_row;
+    const u64 row = same_row ? TryRead<u64>(lookup, 8).value_or(0) : 0;
+    const u32 variation = (behavior - 100000000) / 1000;
+    const u32 judge = behavior % 1000;
+    const auto form = MeleeForm(variation, judge);
+    const auto weapon = MeleeProfile(variation, judge, TryRead<u8>(row, 0x77).value_or(255));
+    u32 item = owned ? BaseWeaponId(TryRead<s32>(attack_data, 0x84).value_or(-1)) : 0;
+    if (!item) item = EquippedWeapon(player, judge >= 800 && judge <= 829);
+
+    std::scoped_lock lock(event_lock);
+    const auto now = Clock::now();
+    const auto strength = ClassifyMelee(behavior, row);
+    recent_melee[next_melee] = {behavior, strength, weapon, item, form, now};
+    next_melee = (next_melee + 1) % recent_melee.size();
+    if (now - last_swing < 75ms) return;  // A swing can create volumes for both hands.
+    last_swing = now;
+    if (charge.event.action == BB_HAPTIC_CHARGING) charge = {};
+    if (attack.event.action != BB_HAPTIC_NONE &&
+        (attack.event.action < BB_HAPTIC_LIGHT_SWING || attack.event.action == BB_HAPTIC_WORLD_IMPACT) &&
+        now - attack.when < 110ms) return;
+
+    const auto action = SwingActions[static_cast<size_t>(strength)];
+    attack = {{action, weapon, 255, 0, BB_HAPTIC_SURFACE_UNKNOWN, item, form}, now};
+}
+
+void PS4_SYSV_ABI OnObjectAction(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    // ObjAct has accepted the actor and is committing the selected ObjActParam animation.
+    const auto animation = static_cast<u32>(registers->rax);
+    BbCombatHapticAction action;
+    const char* name;
+    switch (animation) {
+    case 101110: case 101111: case 101112:
+        action = BB_HAPTIC_DOOR;
+        name = "heavy door";
+        break;
+    case 101150: case 101151: case 101230:
+        action = BB_HAPTIC_LEVER;
+        name = "lever pull";
+        break;
+    case 101141: case 101142: case 101143:
+        action = BB_HAPTIC_CHEST;
+        name = "chest open";
+        break;
+    default:
+        return;
+    }
+    if (!registers->r12 || registers->r12 != Player()) return;
+    if (QueueActivity({action, BB_HAPTIC_STANDARD, 255, 0, BB_HAPTIC_SURFACE_UNKNOWN}, 1200ms) && trace_contacts)
+        LOG_NOTICE(Loader, "DSE local {} animation {}", name, animation);
+}
+
+void PS4_SYSV_ABI OnRotateAction(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    // RotateCharacter has resolved the target and the actor and is committing its animation.
+    const auto animation = static_cast<u32>(registers->r12);
+    BbCombatHapticAction action;
+    const char* name;
+    switch (animation) {
+    case 101130:  // The local script starts the fog traversal.
+        action = BB_HAPTIC_FOG;
+        name = "fog traversal";
+        break;
+    case 101170:  // Common event 7100 runs once on a new lamp's light request.
+        action = BB_HAPTIC_LAMP;
+        name = "lamp lighting";
+        break;
+    default:
+        return;
+    }
+    if (!registers->r15 || registers->r15 != Player()) return;
+    if (QueueActivity({action, BB_HAPTIC_STANDARD, 255, 0, BB_HAPTIC_SURFACE_UNKNOWN}, 1200ms) && trace_contacts)
+        LOG_NOTICE(Loader, "DSE local {} animation {}", name, animation);
+}
+
+void PS4_SYSV_ABI OnItemReceipt(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled) return;
+    // Inventory delivery has succeeded and is linking a receipt into the local popup queue.
+    const u64 queue = TryRead<u64>(guest_image, ItemReceiptQueueOffset).value_or(0);
+    if (!queue || registers->rbx != queue || !Player()) return;
+    const s32 item = TryRead<s32>(registers->rax, 0x10).value_or(-1);
+    const s32 count = TryRead<s32>(registers->rax, 0x14).value_or(0);
+    if (item < 0 || count <= 0) return;
+    if (QueueActivity({BB_HAPTIC_PICKUP, BB_HAPTIC_STANDARD, 255, 0, BB_HAPTIC_SURFACE_UNKNOWN}, 400ms) &&
+        trace_contacts) {
+        LOG_NOTICE(Loader, "DSE local item receipt {} count {}", item, count);
+    }
+}
+
+void PS4_SYSV_ABI OnEffectApplied(u64, const GuestRegisterSnapshot* registers) {
+    if (!enabled || static_cast<u8>(registers->r12) != 1) return;
+    const auto effect = static_cast<u32>(registers->r14);
+    BbCombatHapticAction action;
+    switch (effect) {
+    case 206: // The native weapon transformation animation's mode-change effect.
+        action = BB_HAPTIC_TRANSFORM;
+        break;
+    case 392: case 393: // The roll / quickstep animation's judgment effects.
+        action = BB_HAPTIC_DODGE;
+        break;
+    case 3010: case 3020: case 3030: case 3040: case 3060:
+        action = BB_HAPTIC_HEAL;
+        break;
+    default:
+        return;
+    }
+    // R12B is the successful return from the common applicator, and R13 is the recipient.
+    const u64 player = Player();
+    if (!player || registers->r13 != player) return;
+    const u32 item = action == BB_HAPTIC_TRANSFORM ? EquippedWeapon(player) : 0;
+    const auto weapon = item ? MeleeProfile(WeaponVariation(item), 0, 255) : BB_HAPTIC_STANDARD;
+    const auto strength = static_cast<uint8_t>(effect == 393 ? 210 : 255);
+    const auto interval = action == BB_HAPTIC_DODGE ? 135ms : action == BB_HAPTIC_TRANSFORM ? 350ms : 500ms;
+    if (QueueActivity({action, weapon, strength, 0, BB_HAPTIC_SURFACE_UNKNOWN, item}, interval) && trace_contacts)
+        LOG_NOTICE(Loader, "DSE local activity effect {} action {}", effect, static_cast<unsigned>(action));
+}
+
+void PS4_SYSV_ABI OnPlayerAnimation(u64 entering, const GuestRegisterSnapshot* registers) {
+    const bool charging = heavy_down.load(std::memory_order_relaxed);
+    if (!enabled || (!entering && !charging)) return;
+    constexpr std::string_view charge_prefix = "AtkPowerLoop";
+    constexpr std::string_view transform_prefix = "ChangeGimmick";
+    // Havok's script generator stores tagged hkStringPtr callback expressions.
+    const u64 script = TryRead<u64>(registers->rdi, entering ? 0x90 : 0xB0).value_or(0) & ~u64{1};
+    const auto name = TryRead<std::array<char, transform_prefix.size()>>(script, 0);
+    if (!name) return;
+    const std::string_view prefix{name->data(), name->size()};
+    const bool charge_loop = charging && prefix.starts_with(charge_prefix);
+    const bool ladder = entering && prefix.starts_with("Ladder_");
+    const bool dodge = entering && (prefix.starts_with("Rolling") || prefix.starts_with("Step"));
+    const bool transform = entering && prefix == transform_prefix;
+    if (!charge_loop && !ladder && !dodge && !transform) return;
+
+    const u64 player = Player();
+    const u64 character = TryRead<u64>(registers->rsi, 0).value_or(0);
+    if (!player || !character || HavokCharacter(player) != character) return;
+
+    if (!charge_loop) {
+        const auto text = TryRead<std::array<char, 48>>(script, 0);
+        if (!text) return;
+        const auto end = std::find(text->begin(), text->end(), '\0');
+        const std::string_view state{text->data(), static_cast<size_t>(end - text->begin())};
+        if (ladder) {
+            const bool left = state == "Ladder_Up_Left_onActivate()" || state == "Ladder_Down_Left_onActivate()";
+            const bool right = state == "Ladder_Up_Right_onActivate()" || state == "Ladder_Down_Right_onActivate()";
+            if (!left && !right) return;
+            const auto strength = static_cast<uint8_t>(state.starts_with("Ladder_Up_") ? 230 : 204);
+            const BbCombatHapticEvent step{BB_HAPTIC_LADDER_STEP, BB_HAPTIC_STANDARD, strength, 0,
+                                         BB_HAPTIC_SURFACE_UNKNOWN, 0, BB_HAPTIC_FORM_NORMAL,
+                                         static_cast<uint8_t>(left)};
+            if (QueueActivity(step, 85ms) && trace_contacts)
+                LOG_NOTICE(Loader, "DSE local ladder step {}", left ? "left" : "right");
+        } else if (dodge) {
+            const bool rolling = state == "Rolling_onActivate()" || state == "Rolling00_onActivate()";
+            const bool quickstep = state == "Step_onActivate()" || state == "Step00_onActivate()";
+            if (!rolling && !quickstep) return;
+            const auto strength = static_cast<uint8_t>(rolling ? 255 : 210);
+            if (QueueActivity({BB_HAPTIC_DODGE, BB_HAPTIC_STANDARD, strength, 0, BB_HAPTIC_SURFACE_UNKNOWN}, 135ms) &&
+                trace_contacts) {
+                LOG_NOTICE(Loader, "DSE local dodge {}", state);
+            }
+        } else {
+            const bool left = state == "ChangeGimmick_LeftSide_ModeA_onActivate()" ||
+                              state == "ChangeGimmick_LeftSide_ModeB_onActivate()";
+            const bool right = state == "ChangeGimmick_RightSide_ModeA_onActivate()" ||
+                               state == "ChangeGimmick_RightSide_ModeB_onActivate()";
+            if (!left && !right) return;
+            const u32 item = EquippedWeapon(player, left);
+            if (!item) return;
+            const auto weapon = MeleeProfile(WeaponVariation(item), 0, 255);
+            if (QueueActivity({BB_HAPTIC_TRANSFORM, weapon, 255, 0, BB_HAPTIC_SURFACE_UNKNOWN, item}, 350ms) &&
+                trace_contacts) {
+                LOG_NOTICE(Loader, "DSE local weapon transform {} item {}", state, item);
+            }
+        }
+        return;
+    }
+    std::scoped_lock lock(event_lock);
+    const auto now = Clock::now();
+    if (!heavy_down || charge_active == (entering != 0)) return;
+    charge_active = entering != 0;
+    const auto action = charge_active ? BB_HAPTIC_CHARGING : BB_HAPTIC_CHARGE_ENDED;
+    const u32 judge = TryRead<char>(script, charge_prefix.size()) == 'B' ? 400 : 0;
+    const u32 item = EquippedWeapon(player);
+    const u32 variation = WeaponVariation(item);
+    charge = {{action, MeleeProfile(variation, judge, 255), 255, 0,
+               BB_HAPTIC_SURFACE_UNKNOWN, item, MeleeForm(variation, judge)}, now};
+}
+
+template <size_t Size>
+bool Matches(u64 offset, const std::array<u8, Size>& bytes) {
+    return offset <= guest_size && Size <= guest_size - offset &&
+           TryRead<std::array<u8, Size>>(guest_image, offset) == bytes;
+}
+
+} // namespace
+
+extern "C" void bb_dse_combat_install(u64 image, u64 size, const char* title, const char* version) {
+    const std::string_view serial{title};
+    const char* haptics = std::getenv("BB_DSE_HAPTICS");
+    if (std::string_view{version} != "01.09" || (serial != "CUSA00207" && serial != "CUSA03173") ||
+        (haptics && std::string_view{haptics} == "0") || Coop::EnvFlagEnabled("BB_ONLINE") ||
+        Coop::EnvFlagEnabled("SHADPS4_BLOODBORNE_SEAMLESS_COOP") ||
+        Coop::EnvFlagEnabled("SHADPS4_BLOODBORNE_RE_TRACE")) return;
+
+    guest_image = image;
+    guest_size = size;
+    npc_type_verified = Matches(NpcParamFunction, NpcParamAccess);
+    trace_contacts = Coop::EnvFlagEnabled("BB_DSE_CONTACT_TRACE");
+    if (!Matches(Game::HitOffset, Game::HitPrologue) || !Matches(Game::HitAppliedOffset, Game::HitApplied) ||
+        !Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + Game::HitOffset), Game::HitPrologue, 0, BeforeHit) ||
+        !Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + Game::HitAppliedOffset), Game::HitApplied, 0, AfterHit)) {
+        LOG_NOTICE(Loader, "DSE combat haptics disabled: the game's hit sites were not available");
+        return;
+    }
+    const bool projectiles = Matches(Game::CreateBulletOffset, Game::CreateBulletPrologue) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + Game::CreateBulletOffset),
+                                   Game::CreateBulletPrologue, 0, OnProjectile);
+    const bool swings = Matches(SwingStartedOffset, SwingStarted) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + SwingStartedOffset),
+                                   SwingStarted, 0, OnSwingStarted);
+    const bool charge_exit = Matches(ScriptDeactivateOffset, ScriptPrologue) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + ScriptDeactivateOffset),
+                                   ScriptPrologue, 0, OnPlayerAnimation);
+    const bool animation = Matches(ScriptActivateOffset, ScriptPrologue) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + ScriptActivateOffset),
+                                   ScriptPrologue, 1, OnPlayerAnimation);
+    const bool map_impacts = Matches(MapImpactOffset, MapImpact) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + MapImpactOffset), MapImpact, 0, OnWorldImpact);
+    const bool object_impacts = Matches(ObjectImpactOffset, ObjectImpact) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + ObjectImpactOffset), ObjectImpact, 1, OnWorldImpact);
+    const bool objects = Matches(ObjectActionOffset, ObjectAction) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + ObjectActionOffset), ObjectAction, 0, OnObjectAction);
+    const bool scripted = Matches(RotateActionOffset, RotateAction) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + RotateActionOffset), RotateAction, 0, OnRotateAction);
+    const bool pickup = Matches(ItemReceiptOffset, ItemReceipt) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + ItemReceiptOffset), ItemReceipt, 0, OnItemReceipt);
+    const bool healing = Matches(EffectAppliedOffset, EffectApplied) &&
+        Core::InstallGuestCodeHook(reinterpret_cast<void*>(image + EffectAppliedOffset), EffectApplied, 0,
+                                   OnEffectApplied);
+    enabled = true;
+    LOG_NOTICE(Loader, "DSE combat haptics: confirmed hits and damage enabled, projectiles {}, swings {}, charging {}, "
+                       "map impacts {}, object impacts {}, object actions {}, scripted actions {}, ladder steps {}, "
+                       "item receipts {}, healing {}",
+               projectiles ? "enabled" : "unavailable", swings ? "enabled" : "unavailable",
+               animation && charge_exit ? "enabled" : "unavailable", map_impacts ? "enabled" : "unavailable",
+               object_impacts ? "enabled" : "unavailable", objects ? "enabled" : "unavailable",
+               scripted ? "enabled" : "unavailable",
+               animation ? "enabled" : "unavailable", pickup ? "enabled" : "unavailable",
+               healing ? "enabled" : "unavailable");
+}
+
+extern "C" int bb_dse_combat_input(int heavy) {
+    if (!enabled) return 0;
+    std::scoped_lock lock(event_lock);
+    const bool released = heavy_down && !heavy;
+    heavy_down = !!heavy;
+    if (released) {
+        charge_active = false;
+        charge = {};
+    }
+    return released;
+}
+
+extern "C" int bb_dse_combat_take(BbCombatHapticEvent* event) {
+    if (!enabled) return 0;
+    std::scoped_lock lock(event_lock);
+    const auto now = Clock::now();
+    for (TimedEffect* pending : {&damage, &attack, &charge, &activity}) {
+        if (pending->event.action != BB_HAPTIC_NONE && now - pending->when <= 200ms) {
+            *event = pending->event;
+            *pending = {};
+            return 1;
+        }
+        *pending = {};
+    }
+    return 0;
+}
