diff --git a/gpu/seamless/bbcoop/haptic_profiles.cpp b/gpu/seamless/bbcoop/haptic_profiles.cpp
new file mode 100644
index 0000000..e098400
--- /dev/null
+++ b/gpu/seamless/bbcoop/haptic_profiles.cpp
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "bbcoop/haptic_profiles.h"
+
+#include <array>
+#include <charconv>
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+
+namespace {
+using Json = nlohmann::json;
+
+constexpr std::array<std::string_view, BB_DSE_CURVE_COUNT> CurveNames{
+    "", "light_swing", "heavy_swing", "charged_swing", "charging", "thrust", "whip",
+    "rotary", "recoil", "cannon", "flesh", "stone", "wood", "metal", "door", "ladder",
+    "lever", "lamp", "fog", "chest", "pickup", "heal", "transform", "dodge",
+};
+constexpr std::array<std::string_view, BB_HAPTIC_WEAPON_PROFILE_COUNT> ProfileNames{
+    "standard", "light_blade", "long_blade", "thrust", "fist", "saw", "extended_saw",
+    "axe", "long_axe", "hammer", "whip", "heavy_whip", "rotary", "explosive", "arcane",
+    "pistol", "repeating_pistol", "blunderbuss", "rifle", "cannon", "gatling", "sprayer", "bow",
+};
+constexpr std::array<std::string_view, BB_HAPTIC_FORM_COUNT> FormNames{
+    "normal", "transformed", "projectile",
+};
+
+struct TuningField {
+    std::string_view name;
+    float BbDseWeaponTuning::*member;
+    float minimum, maximum;
+};
+constexpr std::array Fields{
+    TuningField{"duration", &BbDseWeaponTuning::duration, 0.5f, 2.0f},
+    TuningField{"left", &BbDseWeaponTuning::left, 0.0f, 1.6f},
+    TuningField{"right", &BbDseWeaponTuning::right, 0.0f, 1.6f},
+    TuningField{"pitch", &BbDseWeaponTuning::pitch, 0.6f, 1.5f},
+    TuningField{"flutter", &BbDseWeaponTuning::flutter, 0.0f, 0.70f},
+};
+using Tuning = std::array<std::optional<float>, Fields.size()>;
+using WeaponForms = std::array<Tuning, BB_HAPTIC_FORM_COUNT>;
+
+struct ProfilePack {
+    std::string name = "custom";
+    std::array<std::vector<BbDseMotionPoint>, BB_DSE_CURVE_COUNT> curves;
+    std::array<Tuning, BB_HAPTIC_WEAPON_PROFILE_COUNT> profiles;
+    std::map<uint32_t, WeaponForms> weapons;
+};
+
+// The game view is fixed before the input and WASAPI threads start.
+ProfilePack pack;
+
+float Number(const Json& value, float minimum, float maximum, std::string_view field) {
+    if (value.is_number()) {
+        const float number = value.get<float>();
+        if (std::isfinite(number) && number >= minimum && number <= maximum) return number;
+    }
+    throw std::runtime_error(std::string{field} + " is outside its supported range");
+}
+
+void RequireObject(const Json& value, std::string_view name) {
+    if (!value.is_object()) throw std::runtime_error(std::string{name} + " must be an object");
+}
+
+template <size_t Size>
+size_t Lookup(std::string_view key, const std::array<std::string_view, Size>& names) {
+    for (size_t index = 0; index < Size; ++index) {
+        if (!key.empty() && names[index] == key) return index;
+    }
+    throw std::runtime_error("unknown setting " + std::string{key});
+}
+
+Tuning ParseTuning(const Json& value, const std::string& path) {
+    RequireObject(value, path);
+    Tuning tuning;
+    for (const auto& [name, number] : value.items()) {
+        size_t index = 0;
+        while (index < Fields.size() && Fields[index].name != name) ++index;
+        if (index == Fields.size()) throw std::runtime_error("unknown setting " + path + "." + name);
+        const auto& field = Fields[index];
+        tuning[index] = Number(number, field.minimum, field.maximum, path + "." + name);
+    }
+    return tuning;
+}
+
+std::vector<BbDseMotionPoint> ParseCurve(const Json& value, const std::string& path) {
+    if (!value.is_array() || value.size() < 2 || value.size() > 64)
+        throw std::runtime_error(path + " requires 2 to 64 points");
+    std::vector<BbDseMotionPoint> points;
+    points.reserve(value.size());
+    for (const auto& row : value) {
+        if (!row.is_array() || row.size() != 5 || !row[0].is_number_integer())
+            throw std::runtime_error(path + " requires [ms, left, right, left_hz, right_hz]");
+        const auto ms = static_cast<uint16_t>(Number(row[0], 0, 2500, path + " time"));
+        if (points.empty() ? ms != 0 : ms <= points.back().ms)
+            throw std::runtime_error(path + " must start at 0 and have increasing times");
+        points.push_back({ms, {Number(row[1], 0, 1, path + " left"), Number(row[2], 0, 1, path + " right")},
+                          {Number(row[3], 20, 250, path + " left_hz"), Number(row[4], 20, 250, path + " right_hz")}});
+    }
+    return points;
+}
+
+ProfilePack Parse(const Json& json) {
+    RequireObject(json, "profile pack");
+    if (!json.contains("version") || !json["version"].is_number_integer() || json["version"] != 1)
+        throw std::runtime_error("expected profile pack version 1");
+    ProfilePack result;
+    if (const auto it = json.find("name"); it != json.end()) {
+        result.name = it->get<std::string>();
+        if (result.name.size() > 96 || result.name.find_first_of("\r\n\t") != std::string::npos)
+            throw std::runtime_error("invalid profile pack name");
+    }
+    if (const auto it = json.find("curves"); it != json.end()) {
+        RequireObject(*it, "curves");
+        for (const auto& [name, value] : it->items())
+            result.curves[Lookup(name, CurveNames)] = ParseCurve(value, "curves." + name);
+    }
+    if (const auto it = json.find("profiles"); it != json.end()) {
+        RequireObject(*it, "profiles");
+        for (const auto& [name, value] : it->items())
+            result.profiles[Lookup(name, ProfileNames)] = ParseTuning(value, "profiles." + name);
+    }
+    if (const auto it = json.find("weapons"); it != json.end()) {
+        RequireObject(*it, "weapons");
+        for (const auto& [name, forms] : it->items()) {
+            uint32_t weapon{};
+            const auto end = name.data() + name.size();
+            const auto id = std::from_chars(name.data(), end, weapon);
+            if (id.ec != std::errc{} || id.ptr != end || weapon == 0 || weapon % 100000 != 0 ||
+                std::to_string(weapon) != name)
+                throw std::runtime_error("invalid base weapon ID " + name);
+            RequireObject(forms, "weapons." + name);
+            auto& settings = result.weapons[weapon];
+            for (const auto& [form, value] : forms.items())
+                settings[Lookup(form, FormNames)] = ParseTuning(value, "weapons." + name + "." + form);
+        }
+    }
+    return result;
+}
+
+void Apply(const Tuning& settings, BbDseWeaponTuning& tuning) {
+    for (size_t index = 0; index < Fields.size(); ++index) {
+        if (settings[index]) tuning.*Fields[index].member = *settings[index];
+    }
+}
+} // namespace
+
+extern "C" void bb_dse_profiles_load(const char* app0) {
+    pack = {};
+    if (!app0 || !*app0) return;
+    try {
+        const std::string_view directory{app0};
+        const auto root = std::filesystem::path{std::u8string{directory.begin(), directory.end()}};
+        const auto file = root / "dvdroot_ps4" / "other" / "bbport-dse-haptics.json";
+        if (!std::filesystem::exists(file)) {
+            std::puts("Runtime: DSE using built-in haptic profiles");
+            return;
+        }
+        if (!std::filesystem::is_regular_file(file) || std::filesystem::file_size(file) > 256 * 1024)
+            throw std::runtime_error("expected a regular profile file of at most 256 KiB");
+        std::ifstream input(file, std::ios::binary);
+        if (!input) throw std::runtime_error("could not open profile pack");
+        // An overlay supplies one complete file. Publish only after validating every override.
+        pack = Parse(Json::parse(input));
+        std::printf("Runtime: DSE haptic profiles loaded (%s, %zu weapons)\n", pack.name.c_str(), pack.weapons.size());
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "Runtime: DSE haptic profile rejected (%s); using built-in profiles\n", error.what());
+    }
+}
+
+extern "C" const BbDseMotionPoint* bb_dse_profile_curve(BbDseCurve curve, unsigned* count) {
+    const auto& points = pack.curves[curve];
+    *count = static_cast<unsigned>(points.size());
+    return points.empty() ? nullptr : points.data();
+}
+
+extern "C" void bb_dse_profile_tuning(const BbCombatHapticEvent* event, BbDseWeaponTuning* tuning) {
+    Apply(pack.profiles[event->weapon], *tuning);
+    if (const auto it = pack.weapons.find(event->weapon_id); it != pack.weapons.end())
+        Apply(it->second[event->form], *tuning);
+}
