+#endif
+
+static float actuator_level(unsigned motor, float strength) {
+    return (motor == 0 ? 0.60f : 0.42f) * sqrtf(SDL_min(strength / 255.0f, 1.0f));
+}
+
+static bool is_damage(BbCombatHapticAction action) {
+    return action == BB_HAPTIC_LIGHT_DAMAGE || action == BB_HAPTIC_HEAVY_DAMAGE;
+}
+
+static bool is_swing(BbCombatHapticAction action) {
+    return action >= BB_HAPTIC_LIGHT_SWING && action <= BB_HAPTIC_CHARGED_SWING;
+}
+
+static bool is_activity(BbCombatHapticAction action) {
+    return action >= BB_HAPTIC_DOOR && action < BB_HAPTIC_ACTION_COUNT;
+}
+
+static BbDseCurve curve_for(const BbCombatHapticEvent *event) {
+    if (event->surface != BB_HAPTIC_SURFACE_UNKNOWN) return surface_curves[event->surface];
+    if (event->action == BB_HAPTIC_SHOT) {
+        switch (event->weapon) {
+        case BB_HAPTIC_CANNON: return BB_DSE_CURVE_CANNON;
+        case BB_HAPTIC_SPRAYER: case BB_HAPTIC_ARCANE: return BB_DSE_CURVE_ROTARY;
+        case BB_HAPTIC_BOW: return BB_DSE_CURVE_THRUST;
+        default: return BB_DSE_CURVE_RECOIL;
+        }
+    }
+    if (is_swing(event->action)) {
+        switch (event->weapon) {
+        case BB_HAPTIC_THRUST: return BB_DSE_CURVE_THRUST;
+        case BB_HAPTIC_WHIP: case BB_HAPTIC_HEAVY_WHIP: return BB_DSE_CURVE_WHIP;
+        case BB_HAPTIC_HAMMER: case BB_HAPTIC_LONG_AXE:
+            if (event->action == BB_HAPTIC_LIGHT_SWING) return BB_DSE_CURVE_HEAVY_SWING;
+            break;
+        case BB_HAPTIC_ROTARY: return BB_DSE_CURVE_ROTARY;
+        default: break;
+        }
+    }
+    return combat_curves[event->action];
+}
+
+static DseCombatPulse combat_pulse(const BbCombatHapticEvent *event) {
+    BbDseWeaponTuning tune = weapon_tuning[event->weapon];
+    bb_dse_profile_tuning(event, &tune);
+    const BbDseCurve curve = curve_for(event);
+    DseMotion motion;
+    motion.points = bb_dse_profile_curve(curve, &motion.count);
+    if (!motion.points) motion = built_in_curves[curve];
+    const bool contact = event->surface != BB_HAPTIC_SURFACE_UNKNOWN;
+    float strength = event->strength / 255.0f;
+    DseCombatPulse pulse = { .event = *event, .motion = motion,
+                             .duration = contact ? 1.0f : tune.duration,
+                             .pitch = contact ? 1.0f : tune.pitch,
+                             .flutter = contact ? 0.0f : tune.flutter };
+    if (pulse.motion.points) {
+        if (contact && event->action != BB_HAPTIC_WORLD_IMPACT) {
+            if (event->action == BB_HAPTIC_LIGHT_HIT) strength *= 0.76f;
+            if (event->action == BB_HAPTIC_CHARGED_HIT) pulse.duration *= 1.24f;
+        }
+        if (is_swing(event->action) && curve != combat_curves[event->action]) {
+            const unsigned variant = (unsigned)(event->action - BB_HAPTIC_LIGHT_SWING);
+            static const float sweep_strength[] = {0.66f, 0.84f, 1.0f};
+            strength *= sweep_strength[variant];
+            pulse.duration *= 1.0f + 0.21f * variant;
+        }
+        pulse.total = (Uint32)(pulse.motion.points[pulse.motion.count - 1].ms * FRAMES_PER_MS * pulse.duration);
+        pulse.gain[0] = 0.66f * tune.left * strength;
+        pulse.gain[1] = 0.57f * tune.right * strength;
+        return pulse;
+    }
+
+    const DseCombatPreset *preset = &combat_presets[event->action];
+    const Uint32 tail_bonus = event->boss ? 32 : 0;
+    const float weight[2] = {tune.left * (event->boss ? 1.18f : 1.0f), tune.right};
+    pulse.strike_end = preset->strike_ms * FRAMES_PER_MS;
+    pulse.total = (preset->strike_ms + preset->tail_ms + tail_bonus) * FRAMES_PER_MS;
+    for (unsigned motor = 0; motor < 2; ++motor) {
+        pulse.strike[motor] = actuator_level(motor, preset->strike[motor] * weight[motor] * strength);
+        pulse.tail[motor] = actuator_level(motor, preset->tail[motor] * weight[motor] * strength);
+    }
+    return pulse;
+}
+
+static void motion_sample(const DseCombatPulse *pulse, Uint32 frame, unsigned *point,
+                          float level[2], float hz[2]) {
+    const BbDseMotionPoint *points = pulse->motion.points;
+    const float elapsed = frame / (FRAMES_PER_MS * pulse->duration);
+    while (*point + 1 < pulse->motion.count && elapsed >= points[*point].ms)
+        ++*point;
+    const BbDseMotionPoint *from = &points[*point - 1];
+    const BbDseMotionPoint *to = &points[*point];
+    const float t = (elapsed - from->ms) / (to->ms - from->ms);
+    const float ripple = pulse->flutter > 0.0f ? 1.0f - pulse->flutter *
+        (0.5f + 0.5f * sinf((float)frame * (6.283185307f * 28.0f / SAMPLE_RATE))) : 1.0f;
+    for (unsigned grip = 0; grip < 2; ++grip) {
+        const unsigned source = pulse->event.mirror ? 1 - grip : grip;
+        level[grip] = ripple * pulse->gain[grip] * (from->level[source] + t * (to->level[source] - from->level[source]));
+        hz[grip] = pulse->pitch * (from->hz[source] + t * (to->hz[source] - from->hz[source]));
+    }
+}
+
+static void synthesize(int16_t *samples, Uint32 frames, Uint32 active, DseEffect effect,
+                       DseCombatPulse combat, DseActuator motors[2]) {
+    const float level[2] = { actuator_level(0, effect.low), actuator_level(1, effect.high) };
+    const float cycle = 6.283185307f;
+    unsigned next_point = 1;
+    for (Uint32 i = 0; i < frames; ++i, samples += CHANNELS) {
+        samples[0] = samples[1] = 0;
+        const Uint32 combat_frame = combat.frame + i;
+        float combat_level[2] = {0.0f, 0.0f};
+        float hz[2] = {45.0f, 95.0f};
+        if (combat_frame < combat.total) {
+            if (combat.motion.points) {
+                motion_sample(&combat, combat_frame, &next_point, combat_level, hz);
+            } else {
+                const float *impact = combat_frame < combat.strike_end ? combat.strike : combat.tail;
+                combat_level[0] = impact[0];
+                combat_level[1] = impact[1];
+            }
+        }
+        for (unsigned j = 0; j < 2; ++j) {
+            DseActuator *motor = &motors[j];
+            const float target = SDL_min(0.96f, SDL_max(i < active ? level[j] : 0.0f, combat_level[j]));
+            /* Smooth strength changes over a few milliseconds. */
+            motor->level += (target - motor->level) * 0.006f;
+            if (target == 0.0f && motor->level < 1.0f / 32768.0f) motor->level = 0.0f;
+            samples[j + 2] = (int16_t)(32767.0f * motor->level * sinf(motor->phase));
+            motor->phase += cycle * hz[j] / SAMPLE_RATE;
+            if (motor->phase >= cycle) motor->phase -= cycle;
+        }
+    }
+}
+
+typedef struct {
+    DseEffect effect;
+    DseCombatPulse combat;
+    Uint32 active, retained;
+    bool sound, combat_active;
+} DseRenderBlock;
+
+static DseRenderBlock render_samples(int16_t *samples, Uint32 frames, Uint32 queued,
+                                     DseActuator motors[2]) {
+    pthread_mutex_lock(&dse.effect_lock);
+    DseEffect effect = dse.effect;
+    Uint32 onset = SDL_min(effect.onset_frames, frames);
+    dse.effect.onset_frames -= onset;
+    DseCombatPulse combat = dse.combat;
+    const bool combat_active = combat.frame < combat.total;
+    if (combat_active) dse.combat.frame = SDL_min(combat.frame + frames, combat.total);
+    pthread_mutex_unlock(&dse.effect_lock);
+    Uint64 now = SDL_GetTicks();
+    Uint64 remaining = effect.end_ms > now ? (effect.end_ms - now) * FRAMES_PER_MS : 0;
+    Uint64 upcoming = remaining > queued ? remaining - queued : 0;
+    Uint32 sustained = upcoming < frames ? (Uint32)upcoming : frames;
+    Uint32 active = SDL_max(onset, sustained);
+    const bool sound = active || combat_active || motors[0].level != 0.0f || motors[1].level != 0.0f;
+    if (sound) synthesize(samples, frames, active, effect, combat, motors);
+    else memset(samples, 0, (size_t)frames * CHANNELS * sizeof(*samples));
+    return (DseRenderBlock){effect, combat, active, onset > sustained ? onset - sustained : 0, sound, combat_active};
+}
+
+static void log_block(DseRenderLog *log, const DseRenderBlock *block) {
+#ifdef _WIN32
+    const unsigned long long system_ms = GetTickCount64();
+#else
+    const unsigned long long system_ms = SDL_GetTicks();
+#endif
+    if (block->active && !log->submitted) {
+        printf("Runtime: DualSense Edge submitted game haptics PCM (frames=%u, low=%u, high=%u, system_ms=%llu)\n",
+               (unsigned)block->active, (unsigned)block->effect.low, (unsigned)block->effect.high, system_ms);
+        log->submitted = true;
+    }
+    if (block->retained && !log->short_pulse) {
+        printf("Runtime: DualSense Edge retained short game haptics pulse (frames=%u, system_ms=%llu)\n",
+               (unsigned)block->retained, system_ms);
+        log->short_pulse = true;
+    }
+    if (block->combat_active) {
+        const BbCombatHapticEvent event = block->combat.event;
+        const unsigned bit = 1u << (unsigned)event.action;
+        unsigned *messages = &log->combat_messages[event.surface];
+        if (!(*messages & bit) || (log->trace && block->combat.frame == 0)) {
+            printf("Runtime: DualSense Edge submitted combat haptics "
+                   "(action=%u, weapon=%u, boss=%u, system_ms=%llu, surface=%u, item=%lu, form=%u, mirror=%u)\n",
+                   (unsigned)event.action, (unsigned)event.weapon, (unsigned)event.boss,
+                   system_ms, (unsigned)event.surface, (unsigned long)event.weapon_id,
+                   (unsigned)event.form, (unsigned)event.mirror);
+            *messages |= bit;
+        }
+    }
+}
+
+static bool wired_edge(SDL_Gamepad *pad) {
+    return SDL_GetHintBoolean("BB_DSE_HAPTICS", true) && SDL_GetGamepadVendor(pad) == SONY &&
+           SDL_GetGamepadProduct(pad) == DUALSENSE_EDGE &&
+           SDL_GetGamepadConnectionState(pad) == SDL_JOYSTICK_CONNECTION_WIRED;
+}
+
+#ifdef _WIN32
+static HRESULT render(IAudioClient *client, IAudioRenderClient *output, UINT32 capacity,
+                      DseActuator motors[2], DseRenderLog *log) {
+    UINT32 queued;
+    HRESULT hr = IAudioClient_GetCurrentPadding(client, &queued);
+    if (FAILED(hr) || queued >= capacity) return hr;
+    const UINT32 frames = capacity - queued;
+    BYTE *buffer;
+    hr = IAudioRenderClient_GetBuffer(output, frames, &buffer);
+    if (FAILED(hr)) return hr;
+    const DseRenderBlock block = render_samples((int16_t *)buffer, frames, queued, motors);
+    hr = IAudioRenderClient_ReleaseBuffer(output, frames, block.sound ? 0 : AUDCLNT_BUFFERFLAGS_SILENT);
+    if (SUCCEEDED(hr)) log_block(log, &block);
+    return hr;
+}
+
+static HRESULT render_session(HANDLE audio_event, int session) {
+    /* Front channels are silent. The rear channels drive the left and right grips. */
+    WAVEFORMATEXTENSIBLE format = {
+        .Format = {
+            .wFormatTag = WAVE_FORMAT_EXTENSIBLE, .nChannels = CHANNELS, .nSamplesPerSec = SAMPLE_RATE,
+            .nAvgBytesPerSec = SAMPLE_RATE * CHANNELS * sizeof(int16_t),
+            .nBlockAlign = CHANNELS * sizeof(int16_t), .wBitsPerSample = 16,
+            .cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX),
+        },
+        .Samples.wValidBitsPerSample = 16,
+        .dwChannelMask = 0x33, /* Front left/right and back left/right. */
+        .SubFormat = {0x00000001, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}}, /* PCM */
+    };
+    IMMDevice *endpoint = NULL;
+    IAudioClient *client = NULL;
+    IAudioRenderClient *output = NULL;
+    DseActuator motors[2] = {0};
+    DseRenderLog log = { .trace = SDL_GetHintBoolean("BB_DSE_CONTACT_TRACE", false) };
+    UINT32 capacity = 0;
+
+    HRESULT hr = find_render_endpoint(&endpoint);
+    if (FAILED(hr)) return hr;
+    hr = IMMDevice_Activate(endpoint, &audio_client_iid, CLSCTX_ALL, NULL, (void **)&client);
+    IMMDevice_Release(endpoint);
+    if (FAILED(hr)) return hr;
+
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_SHARED,
+                                 AUDCLNT_STREAMFLAGS_EVENTCALLBACK | AUDCLNT_STREAMFLAGS_NOPERSIST,
+                                 0, 0, &format.Format, NULL);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_SetEventHandle(client, audio_event);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetBufferSize(client, &capacity);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetService(client, &audio_render_iid, (void **)&output);
+    if (FAILED(hr)) goto done;
+    hr = render(client, output, capacity, motors, &log);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_Start(client);
+    if (FAILED(hr)) goto done;
+
+    SDL_SetAtomicInt(&dse.active_session, session);
+    HANDLE events[] = { dse.stop, audio_event };
+    while (SUCCEEDED(hr)) {
+        DWORD state = WaitForMultipleObjects(SDL_arraysize(events), events, FALSE, 2000);
+        if (state == WAIT_OBJECT_0) break;
+        if (state != WAIT_OBJECT_0 + 1) {
+            hr = HRESULT_FROM_WIN32(state == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError());
+            break;
+        }
+        hr = render(client, output, capacity, motors, &log);
+    }
+    SDL_SetAtomicInt(&dse.active_session, 0);
+    clear_effect();
+    IAudioClient_Stop(client);
+
+done:
+    if (output) IAudioRenderClient_Release(output);
+    IAudioClient_Release(client);
+    return hr;
+}
+
+static unsigned __stdcall render_thread(void *unused) {
+    (void)unused;
+    HRESULT hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (FAILED(hr)) return 0;
+
+    HANDLE audio_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (audio_event) {
+        bool reported = false;
+        int session = 0;
+        do {
+            ResetEvent(audio_event);
+            hr = render_session(audio_event, ++session);
+            if (FAILED(hr) && !reported) {
+                fprintf(stderr, "Runtime: DualSense Edge HD haptics endpoint unavailable (0x%08lX)\n",
+                        (unsigned long)hr);
+                reported = true;
+            }
+            /* The USB audio endpoint can appear later than the game's HID device. */
+        } while (WaitForSingleObject(dse.stop, 1500) == WAIT_TIMEOUT);
+        CloseHandle(audio_event);
+    }
+    CoUninitialize();
+    return 0;
+}
+
+void runtime_dse_attach(SDL_Gamepad *pad) {
+    if (dse.thread || !wired_edge(pad)) return;
+
+    const char *path = SDL_GetGamepadPath(pad);
+    if (!path || !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1,
+                                      dse.hid_path, SDL_arraysize(dse.hid_path))) return;
+
+    dse.stop = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!dse.stop) return;
+    dse.thread = (HANDLE)_beginthreadex(NULL, 0, render_thread, NULL, 0, NULL);
+    if (!dse.thread) {
+        CloseHandle(dse.stop);
+        dse.stop = NULL;
+    }
+}
+
+void runtime_dse_detach(void) {
+    if (!dse.thread) return;
+    runtime_dse_cancel();
+    SetEvent(dse.stop);
+    WaitForSingleObject(dse.thread, INFINITE);
+    CloseHandle(dse.thread);
+    CloseHandle(dse.stop);
+    dse.thread = dse.stop = NULL;
+    dse.pcm_session = 0;
+}
+
+#else
+static bool sysfs_hex(const char *folder, const char *name, unsigned *value) {
+    char path[PATH_MAX];
+    const int length = snprintf(path, sizeof(path), "%s/%s", folder, name);
+    if (length < 0 || (size_t)length >= sizeof(path)) return false;
+    FILE *file = fopen(path, "r");
+    if (!file) return false;
+    const bool read = fscanf(file, "%x", value) == 1;
+    fclose(file);
+    return read;
+}
+
+static bool edge_usb_parent(const char *sysfs, char usb[PATH_MAX]) {
+    if (!realpath(sysfs, usb)) return false;
+    while (strncmp(usb, "/sys/devices/", 13) == 0) {
+        unsigned vendor, product;
+        if (sysfs_hex(usb, "idVendor", &vendor) && sysfs_hex(usb, "idProduct", &product))
+            return vendor == SONY && product == DUALSENSE_EDGE;
+        char *slash = strrchr(usb, '/');
+        if (!slash) return false;
+        *slash = '\0';
+    }
+    return false;
+}
+
+static bool gamepad_usb_parent(const char *path, char usb[PATH_MAX]) {
+    char sysfs[PATH_MAX];
+    const char *leaf = strrchr(path, '/');
+    if (!leaf) return false;
+    ++leaf;
+    if (strncmp(path, "/sys/devices/", 13) == 0) return edge_usb_parent(path, usb);
+    int length;
+    if (strncmp(leaf, "hidraw", 6) == 0)
+        length = snprintf(sysfs, sizeof(sysfs), "/sys/class/hidraw/%s/device", leaf);
+    else if (strncmp(leaf, "event", 5) == 0)
+        length = snprintf(sysfs, sizeof(sysfs), "/sys/class/input/%s/device", leaf);
+    else return false;
+    return length >= 0 && (size_t)length < sizeof(sysfs) && edge_usb_parent(sysfs, usb);
+}
+
+static int open_linux_pcm(snd_pcm_t **out) {
+    char selected[PATH_MAX], audio[PATH_MAX];
+    const bool mapped = gamepad_usb_parent(dse.hid_path, selected);
+    int card = -1, match = -1, result;
+    while ((result = snd_card_next(&card)) == 0 && card >= 0) {
+        char path[80];
+        snprintf(path, sizeof(path), "/sys/class/sound/card%d/device", card);
+        if (!edge_usb_parent(path, audio) || (mapped && strcmp(audio, selected) != 0)) continue;
+        if (match >= 0) return -ENODEV;
+        match = card;
+    }
+    if (result < 0) return result;
+    if (match < 0) return -ENODEV;
+
+    char device[32];
+    snprintf(device, sizeof(device), "hw:%d,0", match);
+    snd_pcm_t *pcm = NULL;
+    result = snd_pcm_open(&pcm, device, SND_PCM_STREAM_PLAYBACK, SND_PCM_NONBLOCK);
+    if (result < 0) return result;
+    result = snd_pcm_set_params(pcm, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED,
+                                CHANNELS, SAMPLE_RATE, 0, 24000);
+    if (result < 0) snd_pcm_close(pcm);
+    else *out = pcm;
+    return result;
+}
+
+static int render_linux_session(snd_pcm_t *pcm, int session) {
+    enum { BLOCK_FRAMES = SAMPLE_RATE / 100 };
+    int16_t samples[BLOCK_FRAMES * CHANNELS];
+    DseActuator motors[2] = {0};
+    DseRenderLog log = {.trace = SDL_GetHintBoolean("BB_DSE_CONTACT_TRACE", false)};
+    int error = 0;
+    SDL_SetAtomicInt(&dse.active_session, session);
+    while (!SDL_GetAtomicInt(&dse.stop)) {
+        int ready = snd_pcm_wait(pcm, 100);
+        if (ready == 0 || ready == -EINTR) continue;
+        if (ready < 0) {
+            if (ready == -EPIPE && snd_pcm_prepare(pcm) == 0) continue;
+            error = ready;
+            break;
+        }
+        const snd_pcm_sframes_t available = snd_pcm_avail_update(pcm);
+        if (available == -EPIPE && snd_pcm_prepare(pcm) == 0) continue;
+        if (available < 0) { error = (int)available; break; }
+        if (available == 0) continue;
+        snd_pcm_sframes_t queued = 0;
+        if (snd_pcm_delay(pcm, &queued) != 0 || queued < 0) queued = 0;
+        const Uint32 frames = (Uint32)SDL_min(available, BLOCK_FRAMES);
+        const DseRenderBlock block = render_samples(samples, frames, (Uint32)queued, motors);
+        Uint32 written = 0;
+        while (written < frames && !SDL_GetAtomicInt(&dse.stop)) {
+            const snd_pcm_sframes_t count = snd_pcm_writei(pcm, samples + written * CHANNELS, frames - written);
+            if (count > 0) { written += (Uint32)count; continue; }
+            if (count == -EPIPE && snd_pcm_prepare(pcm) == 0) continue;
+            if (count == 0 || count == -EAGAIN || count == -EINTR) { SDL_Delay(2); continue; }
+            error = (int)count;
+            break;
+        }
+        if (error < 0) break;
+        if (written == frames) log_block(&log, &block);
+    }
+    SDL_SetAtomicInt(&dse.active_session, 0);
+    clear_effect();
+    return error;
+}
+
+static int render_linux_thread(void *unused) {
+    (void)unused;
+    int session = 0, last_error = 0;
+    while (!SDL_GetAtomicInt(&dse.stop)) {
+        snd_pcm_t *pcm = NULL;
+        int error = open_linux_pcm(&pcm);
+        if (error == 0) {
+            last_error = 0;
+            error = render_linux_session(pcm, ++session);
+            snd_pcm_close(pcm);
+        }
+        if (error < 0 && error != last_error) {
+            fprintf(stderr, "Runtime: DualSense Edge USB ALSA endpoint unavailable (%s)\n", snd_strerror(error));
+            last_error = error;
+        }
+        for (unsigned i = 0; i < 15 && !SDL_GetAtomicInt(&dse.stop); ++i) SDL_Delay(100);
+    }
+    return 0;
+}
+
+void runtime_dse_attach(SDL_Gamepad *pad) {
+    if (dse.thread || !wired_edge(pad)) return;
+    const char *path = SDL_GetGamepadPath(pad);
+    SDL_strlcpy(dse.hid_path, path ? path : "", sizeof(dse.hid_path));
+    SDL_SetAtomicInt(&dse.stop, 0);
+    dse.thread = SDL_CreateThread(render_linux_thread, "DualSense haptics", NULL);
+}
+
+void runtime_dse_detach(void) {
+    if (!dse.thread) return;
+    runtime_dse_cancel();
+    SDL_SetAtomicInt(&dse.stop, 1);
+    SDL_WaitThread(dse.thread, NULL);
+    dse.thread = NULL;
+    dse.pcm_session = 0;
+}
+#endif
+
+static int current_session(void) {
+    const int session = SDL_GetAtomicInt(&dse.active_session);
+    if (!session) {
+        runtime_dse_cancel();
+        dse.pcm_session = 0;
+    }
+    return session;
+}
+
+static bool select_pcm_mode(SDL_Gamepad *pad, int session) {
+    if (dse.pcm_session != session) {
+        /* Cancel any fallback rumble and release the hardware to audio haptics. SDL supplies
+         * the USB report ID. Clear the emulated rumble flags without changing lights or triggers. */
+        const Uint8 audio_mode[47] = {0};
+        SDL_RumbleGamepad(pad, 0, 0, 0);
+        if (!SDL_SendGamepadEffect(pad, audio_mode, sizeof(audio_mode))) return false;
+        dse.pcm_session = session;
+#ifdef _WIN32
+        puts("Runtime: DualSense Edge HD haptics active (USB WASAPI)");
+#else
+        puts("Runtime: DualSense Edge HD haptics active (USB ALSA)");
+#endif
+    }
+    return true;
+}
+
+bool runtime_dse_rumble(SDL_Gamepad *pad, Uint8 low, Uint8 high, Uint32 duration_ms) {
+    const int session = current_session();
+    if (!session) return false;
+    if ((!low && !high) || !duration_ms)
+        return dse.pcm_session == session && queue_rumble(session, 0, 0, 0);
+    return select_pcm_mode(pad, session) && queue_rumble(session, low, high, duration_ms);
+}
+
+bool runtime_dse_combat(SDL_Gamepad *pad, const BbCombatHapticEvent *event) {
+    if (event->action == BB_HAPTIC_CHARGE_ENDED) {
+        runtime_dse_stop_charge();
+        return true;
+    }
+    const int session = current_session();
+    if (!session || event->action <= BB_HAPTIC_NONE || event->action >= BB_HAPTIC_ACTION_COUNT ||
+        (unsigned)event->weapon >= BB_HAPTIC_WEAPON_PROFILE_COUNT ||
+        (unsigned)event->surface >= BB_HAPTIC_SURFACE_COUNT ||
+        (unsigned)event->form >= BB_HAPTIC_FORM_COUNT ||
+        !select_pcm_mode(pad, session)) return false;
+    DseCombatPulse pulse = combat_pulse(event);
+    pthread_mutex_lock(&dse.effect_lock);
+    const bool live = SDL_GetAtomicInt(&dse.active_session) == session;
+    const bool playing = dse.combat.frame < dse.combat.total;
+    const bool keep_damage = playing && is_damage(dse.combat.event.action) && !is_damage(event->action);
+    const BbCombatHapticAction current = dse.combat.event.action;
+    const bool keep_impact = playing &&
+        (is_swing(event->action) || event->action == BB_HAPTIC_CHARGING || is_activity(event->action)) &&
+        !is_swing(current) && current != BB_HAPTIC_CHARGING && !is_activity(current);
+    if (live && !keep_damage && !keep_impact) dse.combat = pulse;
+    pthread_mutex_unlock(&dse.effect_lock);
+    return live;
+}
+
+void runtime_dse_stop_charge(void) {
+    pthread_mutex_lock(&dse.effect_lock);
+    if (dse.combat.event.action == BB_HAPTIC_CHARGING) dse.combat = (DseCombatPulse){0};
+    pthread_mutex_unlock(&dse.effect_lock);
+}
+
+#endif
