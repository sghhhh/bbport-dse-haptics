+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum BbCombatHapticAction {
+    BB_HAPTIC_NONE,
+    BB_HAPTIC_LIGHT_HIT,
+    BB_HAPTIC_HEAVY_HIT,
+    BB_HAPTIC_CHARGED_HIT,
+    BB_HAPTIC_SHOT,
+    BB_HAPTIC_LIGHT_DAMAGE,
+    BB_HAPTIC_HEAVY_DAMAGE,
+    BB_HAPTIC_LIGHT_SWING,
+    BB_HAPTIC_HEAVY_SWING,
+    BB_HAPTIC_CHARGED_SWING,
+    BB_HAPTIC_CHARGING,
+    BB_HAPTIC_CHARGE_ENDED,
+    BB_HAPTIC_ACTION_COUNT,
+} BbCombatHapticAction;
+
+typedef enum BbCombatWeaponGroup {
+    BB_HAPTIC_STANDARD,
+    BB_HAPTIC_LIGHT_BLADE,
+    BB_HAPTIC_HEAVY_WEAPON,
+    BB_HAPTIC_THRUSTING,
+    BB_HAPTIC_FIREARM,
+} BbCombatWeaponGroup;
+
+typedef struct BbCombatHapticEvent {
+    BbCombatHapticAction action;
+    BbCombatWeaponGroup weapon;
+    uint8_t strength;
+    uint8_t boss;
+} BbCombatHapticEvent;
+
+void bb_dse_combat_install(uint64_t image, uint64_t size, const char *title, const char *version);
+int bb_dse_combat_input(int heavy, int left);
+int bb_dse_combat_take(BbCombatHapticEvent *event);
+
+#ifdef __cplusplus
+}
+#endif
