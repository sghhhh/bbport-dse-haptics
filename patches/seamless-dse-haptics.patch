+    [BB_HAPTIC_HEAVY_HIT] = {38, 76, {222, 142}, {104, 37}},
+    [BB_HAPTIC_CHARGED_HIT] = {53, 105, {251, 193}, {143, 55}},
+    [BB_HAPTIC_SHOT] = {25, 42, {118, 244}, {41, 77}},
